# Installed by `breezed daemon install`; re-run it to refresh this file.
[Unit]
Description=breezed - curve-based iDRAC/IPMI fan controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/breezed run --config /etc/breezed/breezed.toml --metrics-port 9762
EnvironmentFile=-/etc/breezed.env
Restart=always
RestartSec=5

# Hardening — small network daemon that shells out to ipmitool
User=breezed
Group=breezed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
